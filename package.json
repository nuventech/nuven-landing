{
  "name": "base-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun granular-images optimize && next build",
    "build:core": "next build",
    "start": "next start",
    "preview": "serve out",
    "lint": "eslint .",
    "prettier": "prettier .",
    "format": "bun run lint --fix && bun prettier --write .",
    "prepare": "husky",
    "fresh-install": "node scripts/fresh-install.js",
    "granular-images": "next-granular-images"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write .",
      "eslint --fix"
    ]
  },
  "renovate": {
    "rangeStrategy": "pin",
    "minimumReleaseAge": "30 days",
    "packageRules": [
      {
        "matchPackagePatterns": [
          ".*"
        ],
        "stabilityDays": 30
      }
    ],
    "labels": [
      "deps"
    ],
    "dependencyDashboard": true
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.4.1",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.28.1",
    "gsap": "3.14.2",
    "lucide-react": "0.554.0",
    "next": "16.0.3",
    "next-granular-images": "1.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "6.8.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2",
    "serve": "14.2.5",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
